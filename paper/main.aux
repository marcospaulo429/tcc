\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {Mediation table (pre-regs 41--43).} Pivotal = $C_H \neq  0$; $C_{Ha} = 0$ = no effect once the model's original next action is held fixed. $H_w$ = \texttt  {write\_file} calls after $j$ in the recorded episode; at $H_w = 0$ the paired action is the last write and $C_{Ha} = 0$ is the expected reading (\S  \ref  {sec:mediation}). A \emph  {screening break} is a point with $C_{HM} \neq  C_M$. Termination duals are analytic ($R_{Ha} \equiv R_H$): a structural check, not a falsifiable control.}}{5}{table.1}\protected@file@percent }
\newlabel{tab:med}{{1}{5}{\textbf {Mediation table (pre-regs 41--43).} Pivotal = $C_H \neq 0$; $C_{Ha} = 0$ = no effect once the model's original next action is held fixed. $H_w$ = \texttt {write\_file} calls after $j$ in the recorded episode; at $H_w = 0$ the paired action is the last write and $C_{Ha} = 0$ is the expected reading (\S \ref {sec:mediation}). A \emph {screening break} is a point with $C_{HM} \neq C_M$. Termination duals are analytic ($R_{Ha} \equiv R_H$): a structural check, not a falsifiable control}{table.1}{}}
